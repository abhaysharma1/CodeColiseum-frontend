# Base URL of the Express backend, including the /api prefix.
# Development example: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# BetterAuth endpoint. Defaults to `${VITE_API_URL}/auth` when omitted.
# Only set this when the auth server lives on a different origin than the API.
VITE_AUTH_URL=http://localhost:5000/api/auth

# Public origin of this SPA (used for absolute links).
VITE_APP_URL=http://localhost:5173

# The Express backend must allow this origin via FRONTEND_URL and
# `trustedOrigins` for cookies to work cross-site.
